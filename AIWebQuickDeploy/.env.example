PORT=9520

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_DATABASE=chatgpt

# Redis
REDIS_PORT=6379
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_USER=
REDIS_DB=0

# �Ƿ���Ի���
ISDEV=false

# �Զ���΢��URL
weChatOpenUrl=https://open.weixin.qq.com
weChatApiUrl=https://api.weixin.qq.com
weChatApiUrlToken=https://api.weixin.qq.com/cgi-bin/token
weChatMpUrl=https://mp.weixin.qq.com

# �Զ����̨·��
ADMIN_SERVE_ROOT=/admin

# 猫饼管理后台域名
MAOBING_BASE_URL=https://admin.maobingai.com

# �����뼰��Ȩ��

# GPT-SoVITS
GPT_SOVITS_BASE_URL=http://127.0.0.1:9880
GPT_SOVITS_STORAGE_ROOT=storage/gpt-sovits
GPT_SOVITS_DEFAULT_TEXT_LANGUAGE=zh

# GPT-SoVITS Retry Configuration
# Maximum number of retry attempts (default: 3)
GPT_SOVITS_MAX_RETRIES=3
# Initial retry delay in milliseconds (default: 1000)
GPT_SOVITS_RETRY_DELAY=1000
# Exponential backoff multiplier (default: 2)
GPT_SOVITS_RETRY_BACKOFF=2

# MiniMax Voice Cloning & TTS (MiniMax 语音克隆和语音合成)
# MiniMax API Key (required) - 从 MiniMax 开放平台获取
MINIMAX_API_KEY=your_minimax_api_key_here
# MiniMax API Base URL (default: https://api.minimaxi.com)
MINIMAX_API_BASE_URL=https://api.minimaxi.com
# Maximum retry attempts (default: 3)
MINIMAX_MAX_RETRIES=3
# Polling interval for async tasks in milliseconds (default: 1000)
MINIMAX_POLL_INTERVAL=1000
# Polling timeout for async tasks in milliseconds (default: 60000)
MINIMAX_POLL_TIMEOUT=60000
